# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Settings.from_env() (and so the odata-jev CLI) reads .env from the current directory.
# Variables already set in the environment take precedence over this file.

# Jev (TypeSafe System One API). Key from https://console.typesafe.ai
TYPESAFE_API_KEY=
# JEV_API_URL=https://api.typesafe.ai/v1/systemone
# JEV_MODEL=jev-latest

# LLM (any OpenAI-compatible chat completions API)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
# LLM_PRICE_INPUT_PER_MTOK=
# LLM_PRICE_OUTPUT_PER_MTOK=

# ODATA_VERSION=v4
